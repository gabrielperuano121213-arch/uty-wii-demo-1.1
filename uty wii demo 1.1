#!/bin/sh
# Compila con la imagen oficial de devkitPro (requiere Docker). Resultado: apps/UndertaleYellow/
set -e
docker run --rm -v "$PWD":/project -w /project devkitpro/devkitppc make package
python3 tools/verificar.py apps/UndertaleYellow

*** ESTO ES CODIGO FUENTE, NO UNA APP INSTALABLE ***

El Homebrew Channel solo muestra carpetas dentro de SD:/apps/ que contengan un archivo
"boot.dol" (o "boot.elf") REAL, compilado para Wii. Este paquete NO incluye ese archivo
(el entorno donde se preparo no tiene el compilador de la Wii), por eso copiarlo a la SD
no hace que aparezca en el Homebrew Channel.

Pasos:
  1) Compila el proyecto (ver README.md: GitHub Actions, Docker o devkitPro).
     Resultado: carpeta apps/UndertaleYellow con boot.dol + meta.xml + icon.png.
  2) Comprueba el resultado:   python3 tools/verificar.py apps/UndertaleYellow
     (debe terminar en "RESULTADO: CORRECTO").
  3) Copia la carpeta UndertaleYellow a SD:/apps/  (SD en FAT32).

Para el juego COMPLETO (no el demake) lee docs/INFORME_AUDITORIA_Y_DECISION.md.

#---------------------------------------------------------------------------------
# Undertale Yellow (demake para Wii) - Makefile estandar de devkitPPC / libogc
#   make           -> genera boot.dol
#   make package   -> ademas copia boot.dol + meta.xml + icon.png a apps/UndertaleYellow/
#   make clean
#---------------------------------------------------------------------------------
.SUFFIXES:
#---------------------------------------------------------------------------------

ifeq ($(strip $(DEVKITPPC)),)
$(error "Define DEVKITPPC en tu entorno: export DEVKITPPC=<ruta a>devkitPPC (el instalador de devkitPro lo hace por ti)")
endif

include $(DEVKITPPC)/wii_rules

#---------------------------------------------------------------------------------
# TARGET   = nombre de salida (el Homebrew Channel exige que se llame boot.dol)
# BUILD    = carpeta de objetos intermedios
# SOURCES  = carpetas con codigo fuente
#---------------------------------------------------------------------------------
TARGET	:=	boot
BUILD	:=	build
SOURCES	:=	source source/core source/world source/dialogue source/battle source/ui source/sys source/data
DATA	:=	
INCLUDES	:=	source source/core source/world source/dialogue source/battle source/ui source/sys source/data	

#---------------------------------------------------------------------------------
# opciones de compilacion
#---------------------------------------------------------------------------------
CFLAGS	= -g -O2 -Wall $(MACHDEP) $(INCLUDE)
CXXFLAGS	=	$(CFLAGS)

LDFLAGS	=	-g $(MACHDEP) -Wl,-Map,$(notdir $@).map

LIBS	:=	-lwiiuse -lbte -logc -lm
LIBDIRS	:=	

#---------------------------------------------------------------------------------
# no hace falta editar nada mas abajo
#---------------------------------------------------------------------------------
ifneq ($(BUILD),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export OUTPUT	:=	$(CURDIR)/$(TARGET)

export VPATH	:=	$(foreach dir,$(SOURCES),$(CURDIR)/$(dir)) \
					$(foreach dir,$(DATA),$(CURDIR)/$(dir))

export DEPSDIR	:=	$(CURDIR)/$(BUILD)

CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
sFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
SFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.S)))
BINFILES	:=	$(foreach dir,$(DATA),$(notdir $(wildcard $(dir)/*.*)))

ifeq ($(strip $(CPPFILES)),)
	export LD	:=	$(CC)
else
	export LD	:=	$(CXX)
endif

export OFILES_BIN	:=	$(addsuffix .o,$(BINFILES))
export OFILES_SOURCES := $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(sFILES:.s=.o) $(SFILES:.S=.o)
export OFILES	:=	$(OFILES_BIN) $(OFILES_SOURCES)

export HFILES := $(addsuffix .h,$(subst .,_,$(BINFILES)))

export INCLUDE	:=	$(foreach dir,$(INCLUDES), -iquote $(CURDIR)/$(dir)) \
				$(foreach dir,$(LIBDIRS),-I$(dir)/include) \
				-I$(CURDIR)/$(BUILD) \
				-I$(LIBOGC_INC)

export LIBPATHS	:=	-L$(LIBOGC_LIB) $(foreach dir,$(LIBDIRS),-L$(dir)/lib)

.PHONY: $(BUILD) clean package run

#---------------------------------------------------------------------------------
$(BUILD):
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile

#---------------------------------------------------------------------------------
package: $(BUILD)
	@mkdir -p apps/UndertaleYellow
	@cp -f boot.dol meta.xml icon.png apps/UndertaleYellow/
	@echo "Listo: copia la carpeta apps/UndertaleYellow a la tarjeta SD (SD:/apps/)"

#---------------------------------------------------------------------------------
clean:
	@echo clean ...
	@rm -fr $(BUILD) $(OUTPUT).elf $(OUTPUT).dol

#---------------------------------------------------------------------------------
run:
	wiiload $(TARGET).dol

#---------------------------------------------------------------------------------
else

DEPENDS	:=	$(OFILES:.o=.d)

#---------------------------------------------------------------------------------
# objetivos principales
#---------------------------------------------------------------------------------
$(OUTPUT).dol: $(OUTPUT).elf
$(OUTPUT).elf: $(OFILES)

$(OFILES_SOURCES) : $(HFILES)

-include $(DEPENDS)

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------

